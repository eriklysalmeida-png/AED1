#include "raylib.h"
#include <stdlib.h>

#define LARGURA_JANELA 800
#define ALTURA_JANELA 600
#define TAM_CELULA 40

// Estrutura de dados: a bola
typedef struct {
    Vector2 pos;
    Vector2 vel;
    float raio;
    Color cor;
} Bola;

// Cria a matriz de fundo decorativa
int **criarMatriz(int linhas, int colunas) {
    int **matriz = (int **)malloc(linhas * sizeof(int *));
    for (int i = 0; i < linhas; i++) {
        matriz[i] = (int *)malloc(colunas * sizeof(int));
        for (int j = 0; j < colunas; j++) {
            matriz[i][j] = GetRandomValue(0, 1);
        }
    }
    return matriz;
}

// Libera a memória da matriz
void liberarMatriz(int **matriz, int linhas) {
    for (int i = 0; i < linhas; i++) {
        free(matriz[i]);
    }
    free(matriz);
}

// Cria o vetor inicial de bolas
Bola *criarBolas(int quantidade) {
    Bola *bolas = (Bola *)malloc(quantidade * sizeof(Bola));
    for (int i = 0; i < quantidade; i++) {
        Bola *b = (bolas + i); 
        b->pos = (Vector2){ GetRandomValue(50, LARGURA_JANELA - 50), GetRandomValue(50, ALTURA_JANELA - 50) };
        b->vel = (Vector2){ (float)GetRandomValue(-5, 5), (float)GetRandomValue(-5, 5) };
        b->raio = 15.0f;
        b->cor = (Color){ GetRandomValue(50, 255), GetRandomValue(50, 255), GetRandomValue(50, 255), 255 };
    }
    return bolas;
}

// Atualiza a física da bola via ponteiro
void atualizarBola(Bola *b) {
    b->pos.x += b->vel.x;
    b->pos.y += b->vel.y;

    if (b->pos.x - b->raio < 0 || b->pos.x + b->raio > LARGURA_JANELA) b->vel.x *= -1;
    if (b->pos.y - b->raio < 0 || b->pos.y + b->raio > ALTURA_JANELA) b->vel.y *= -1;
}

int main(void) {
    InitWindow(LARGURA_JANELA, ALTURA_JANELA, "Exercício 1 - Alocação Dinâmica");
    SetTargetFPS(60);

    int linhas = ALTURA_JANELA / TAM_CELULA;
    int colunas = LARGURA_JANELA / TAM_CELULA;

    int **matriz = criarMatriz(linhas, colunas);
    int quantidadeBolas = 12;
    Bola *bolas = criarBolas(quantidadeBolas);

    while (!WindowShouldClose()) {
        
        
       // EXERCÍCIO 1: Redimensionando o vetor
       

        // Adicionar nova bola
        if (IsKeyPressed(KEY_SPACE)) {
            quantidadeBolas++;
            bolas = (Bola *)realloc(bolas, quantidadeBolas * sizeof(Bola));
            
            // Configurar a nova bola na última posição
            Bola *nova = (bolas + (quantidadeBolas - 1));
            nova->pos = (Vector2){ GetRandomValue(50, LARGURA_JANELA - 50), GetRandomValue(50, ALTURA_JANELA - 50) };
            nova->vel = (Vector2){ (float)GetRandomValue(-5, 5), (float)GetRandomValue(-5, 5) };
            if (nova->vel.x == 0) nova->vel.x = 2; // Evitar bola parada
            if (nova->vel.y == 0) nova->vel.y = 2;
            nova->raio = 15.0f;
            nova->cor = (Color){ GetRandomValue(50, 255), GetRandomValue(50, 255), GetRandomValue(50, 255), 255 };
        }

        // Remover a última bola
        if (IsKeyPressed(KEY_BACKSPACE) && quantidadeBolas > 0) {
            quantidadeBolas--;
            if (quantidadeBolas > 0) {
                bolas = (Bola *)realloc(bolas, quantidadeBolas * sizeof(Bola));
            } else {
                free(bolas);
                bolas = NULL;
            }
        }

        // Atualizar todas as bolas
        for (int i = 0; i < quantidadeBolas; i++) {
            atualizarBola(bolas + i);
        }

        BeginDrawing();
        ClearBackground(RAYWHITE);

        // Desenhar a grade de fundo decorativa
        for (int i = 0; i < linhas; i++) {
            for (int j = 0; j < colunas; j++) {
                Color corFundo = (matriz[i][j] == 1) ? LIGHTGRAY : DARKGRAY;
                DrawRectangle(j * TAM_CELULA, i * TAM_CELULA, TAM_CELULA, TAM_CELULA, corFundo);
                DrawRectangleLines(j * TAM_CELULA, i * TAM_CELULA, TAM_CELULA, TAM_CELULA, BLACK);
            }
        }

        // Desenhar as bolas
        for (int i = 0; i < quantidadeBolas; i++) {
            Bola *b = (bolas + i);
            DrawCircleV(b->pos, b->raio, b->cor);
        }

        DrawText(TextFormat("Bolas na tela (Espaço/Backspace): %d", quantidadeBolas), 10, 10, 20, GREEN);

        EndDrawing();
    }

    // Prevenção de Memory Leak
    if (bolas != NULL) {
        free(bolas);
    }
    liberarMatriz(matriz, linhas);

    CloseWindow();
    return 0;
}
