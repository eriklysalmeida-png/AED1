#include <stdio.h>
#include <stdlib.h>
#include <raylib.h>

#define LARGURA_JANELA 800
#define ALTURA_JANELA 600
#define TAM_CELULA 40
#define LINHAS (ALTURA_JANELA / TAM_CELULA)
#define COLUNAS (LARGURA_JANELA / TAM_CELULA)

typedef struct {
    Vector2 pos;
    Vector2 vel;
    float raio;
    Color cor;
} Bola; //[cite: 3]

int **criarMatriz(int linhas, int colunas) {
    int **matriz = (int **)malloc(linhas * sizeof(int *));
    for (int i = 0; i < linhas; i++) {
        matriz[i] = (int *)malloc(colunas * sizeof(int));
        for (int j = 0; j < colunas; j++) {
            matriz[i][j] = 0; 
        }
    }
    return matriz;
} //[cite: 3]

void liberarMatriz(int **matriz, int linhas) {
    for (int i = 0; i < linhas; i++) {
        free(matriz[i]);
    }
    free(matriz);
} //[cite: 3]

Bola *criarBolas(int quantidade) {
    Bola *bolas = (Bola *)malloc(quantidade * sizeof(Bola));
    for (int i = 0; i < quantidade; i++) {
        bolas[i].pos = (Vector2){ (float)GetRandomValue(50, LARGURA_JANELA - 50), (float)GetRandomValue(50, ALTURA_JANELA - 50) };
        bolas[i].vel = (Vector2){ 2.0f, 2.0f };
        bolas[i].raio = 15.0f;
        bolas[i].cor = RED;
    }
    return bolas;
} //[cite: 3]

void atualizarBola(Bola *b) {
    b->pos.x += b->vel.x;
    if (b->pos.x - b->raio < 0 || b->pos.x + b->raio > LARGURA_JANELA)
        b->vel.x *= -1;
    
    b->pos.y += b->vel.y;
    if (b->pos.y - b->raio < 0 || b->pos.y + b->raio > ALTURA_JANELA)
        b->vel.y *= -1;
} //[cite: 3]

int main(void) {
    InitWindow(LARGURA_JANELA, ALTURA_JANELA, "Exercicio 2 - Colisao entre bolas usando a matriz como mapa de calor");
    SetTargetFPS(60);

    int quantidadeBolas = 12;
    int **matriz = criarMatriz(LINHAS, COLUNAS); //[cite: 3]
    Bola *bolas = criarBolas(quantidadeBolas); //[cite: 3]

    while (!WindowShouldClose()) {
        for (int i = 0; i < quantidadeBolas; i++) {
            atualizarBola(bolas + i); //[cite: 3]

            int coluna = (int)(bolas[i].pos.x / TAM_CELULA); //[cite: 3]
            int linha = (int)(bolas[i].pos.y / TAM_CELULA); //[cite: 3]

            if (linha >= 0 && linha < LINHAS && coluna >= 0 && coluna < COLUNAS) { //[cite: 3]
                matriz[linha][coluna] = 1; //[cite: 3]
            }
        }

        int celulasVisitadas = 0;
        for (int i = 0; i < LINHAS; i++) {
            for (int j = 0; j < COLUNAS; j++) {
                if (matriz[i][j] == 1) {
                    celulasVisitadas++;
                }
            }
        }

        BeginDrawing();
        ClearBackground(RAYWHITE);

        for (int i = 0; i < LINHAS; i++) {
            for (int j = 0; j < COLUNAS; j++) {
                Color corCelula = (matriz[i][j] == 1) ? LIGHTGRAY : DARKGRAY; //[cite: 3]
                DrawRectangle(j * TAM_CELULA, i * TAM_CELULA, TAM_CELULA - 1, TAM_CELULA - 1, corCelula);
            }
        }

        for (int i = 0; i < quantidadeBolas; i++) {
            DrawCircleV(bolas[i].pos, bolas[i].raio, bolas[i].cor);
        }

        char textoContador[50];
        sprintf(textoContador, "Celulas visitadas: %d", celulasVisitadas); //[cite: 3]
        DrawText(textoContador, 10, 10, 20, BLACK);

        EndDrawing();
    }

    free(bolas); //[cite: 3]
    liberarMatriz(matriz, LINHAS); //[cite: 3]
    CloseWindow();

    return 0;
}
